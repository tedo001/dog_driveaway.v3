# ══════════════════════════════════════════════════════
# Smart Dog Threat Detection System — Environment Template
# ══════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file:  cp .env .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to git
# ══════════════════════════════════════════════════════

# System mode: simulation | live | hardware
SYSTEM_MODE=simulation
DETECTOR_BACKEND=yolo

# Detector backend: yolo | ssd
DETECTOR_BACKEND=yolo

# Roboflow API key (get from https://roboflow.com → Settings → API Key)
ROBOFLOW_API_KEY=rf_wZheIHXAH1gamVYKVIDn5wsy2Wp2

# Audio thresholds (tune for your environment)
BARK_THRESHOLD=0.15
GROWL_THRESHOLD=0.10
SCREAM_THRESHOLD=0.20

# Arduino serial port (for hardware mode)
# Windows: COM3, COM4, etc.
# Linux: /dev/ttyUSB0, /dev/ttyACM0
ARDUINO_PORT=COM3
