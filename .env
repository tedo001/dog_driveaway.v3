# ══════════════════════════════════════════════════════
# Smart Dog Threat Detection System — Environment Template
# ══════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env   (Windows)
#   2. Fill in your real values in .env
#   3. NEVER commit .env to git
# ══════════════════════════════════════════════════════

# System mode: simulation | live | hardware
SYSTEM_MODE=simulation

# Detector backend: yolo | ssd
DETECTOR_BACKEND=yolo

# ══════════════════════════════════════════════════════
# Roboflow — Dataset Download
# ══════════════════════════════════════════════════════
# IMPORTANT: Use the PRIVATE API Key, NOT the Publishable one!
#   Private key  = starts with Q1g2... (works for downloads)
#   Publishable  = starts with rf_...  (does NOT work)
#
# How to get it:
#   1. Go to https://app.roboflow.com
#   2. Settings → API Keys
#   3. Click the EYE icon next to Private API Key
#   4. Copy and paste below
ROBOFLOW_API_KEY=your_private_api_key_here

# Your workspace name (from URL: app.roboflow.com/YOUR-WORKSPACE/...)
ROBOFLOW_WORKSPACE=durgamanis-workspace-on48g

# Project name (from URL: app.roboflow.com/workspace/YOUR-PROJECT/...)
ROBOFLOW_PROJECT=dog-behaviour-1

# Dataset version number
ROBOFLOW_VERSION=8

# ══════════════════════════════════════════════════════
# Audio thresholds (tune for your environment)
# ══════════════════════════════════════════════════════
BARK_THRESHOLD=0.15
GROWL_THRESHOLD=0.10
SCREAM_THRESHOLD=0.20

# ══════════════════════════════════════════════════════
# Arduino serial port (for hardware mode only)
# ══════════════════════════════════════════════════════
ARDUINO_PORT=COM3
